{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"],
  // browser.test.ts needs playwright, which is deliberately not a dependency.
  // Check it with tsconfig.browser.json once playwright is installed.
  "exclude": ["node_modules", "dist", "tests/browser.test.ts"]
}
