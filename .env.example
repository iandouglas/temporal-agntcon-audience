# ---------------------------------------------------------------------------
# Copy to .env for local development. On Railway, set these as service variables.
# The service URLs are read only in the Node process and are never sent to a
# browser -- do not add a NEXT_PUBLIC_ prefix to any of them.
# ---------------------------------------------------------------------------

# The agent <-> MCP connection. Renders first, above the four APIs.
mcp_name="AGENT ↔ MCP SERVER"
mcp_url="http://mcp-server.railway.internal:8080"

# The four APIs the MCP server calls.
service_1_name="PAYMENTS API"
service_1_url="http://payments.railway.internal:8080"

service_2_name="SEARCH INDEX"
service_2_url="http://search.railway.internal:8080"

service_3_name="AUTH SERVICE"
service_3_url="http://auth.railway.internal:8080"

service_4_name="NOTIFICATIONS"
service_4_url="http://notifications.railway.internal:8080"

# Gates /control and the reseed endpoint. Without it both are disabled.
admin_token="change-me"

# Shared state and cross-replica fanout. Required if you run more than one
# replica; optional for a single replica or local development.
REDIS_URL="redis://localhost:6379"

# Optional page copy.
page_title="SERVICE CONTROL"
page_subtitle="tap a switch · everyone sees it"
